#!/usr/bin/env bash
# claude-lead — Launch Claude Code in Project Lead Mode
# Reads Linear projects, analyses requirements, creates implementation tickets.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do SOURCE="$(readlink "$SOURCE")"; done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CONFIG_DIR="$(cd "$SCRIPT_DIR/../config" && pwd)"

if ! command -v claude &>/dev/null; then
  echo "Error: Claude Code is not installed."
  echo "Install it with: npm install -g @anthropic-ai/claude-code"
  exit 1
fi

exec claude --verbose \
  --append-system-prompt-file "$CONFIG_DIR/lead-system-prompt.md" \
  "$@"
