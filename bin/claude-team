#!/usr/bin/env bash
# claude-team — Launch Claude Code in Team Lead Mode
# Plans first, asks before proceeding, then spawns 4 agent teammates via tmux.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do SOURCE="$(readlink "$SOURCE")"; done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CONFIG_DIR="$(cd "$SCRIPT_DIR/../config" && pwd)"

if ! command -v claude &>/dev/null; then
  echo "Error: Claude Code is not installed."
  echo "Install it with: npm install -g @anthropic-ai/claude-code"
  exit 1
fi

if ! command -v tmux &>/dev/null; then
  echo "Error: tmux is not installed."
  echo "Install it with: brew install tmux"
  exit 1
fi

exec claude --verbose \
  --teammate-mode tmux \
  --append-system-prompt-file "$CONFIG_DIR/team-system-prompt.md" \
  "$@"
