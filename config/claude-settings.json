{
  "verbose": true,
  "alwaysThinkingEnabled": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/Developer/claude-code-i14u/mods/ship-cockpit"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(tsc *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "mcp__context7",
      "mcp__shadcn",
      "mcp__iconify",
      "mcp__21st-dev",
      "mcp__brave-search",
      "Bash(yarn *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(python3 *)",
      "mcp__linear__get_issue",
      "mcp__linear__list_issues",
      "mcp__linear__list_comments",
      "mcp__linear__get_project",
      "mcp__linear__list_projects",
      "mcp__linear__list_teams",
      "mcp__linear__list_issue_statuses",
      "mcp__linear__list_issue_labels"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r /)",
      "Bash(rm -rf /)",
      "Bash(rm -fr *)",
      "Bash(sudo rm *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(> /dev/*)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(kill -9 *)",
      "Bash(killall *)",
      "Bash(npm publish *)",
      "Bash(npx publish *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker system prune *)",
      "Bash(DROP DATABASE *)",
      "Bash(DROP TABLE *)",
      "Bash(truncate *)",
      "Bash(: > *)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(export *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*secret*.json)",
      "Read(**/*secret*.yaml)",
      "Read(**/*secret*.yml)",
      "Read(**/*secret*.env)",
      "Read(**/*secret*.toml)",
      "Read(**/.secret*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Developer/claude-code-i14u/bin/branch-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch protection..."
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/Developer/claude-code-i14u/bin/rm-guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking rm targets..."
          },
          {
            "type": "command",
            "command": "\"$HOME/Developer/claude-code-i14u/bin/pr-check.sh\" --hook",
            "timeout": 20,
            "statusMessage": "Checking comment and PR body length..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path // \"\"'); P=\"${CLAUDE_PROJECT_DIR:-.}/node_modules/.bin/prettier\"; { [ -n \"$FILE\" ] && [ -x \"$P\" ] && \"$P\" --write \"$FILE\" 2>/dev/null; } || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -q 'git push'; then echo \"[$(date)] $(git -C \"${CLAUDE_PROJECT_DIR:-.}\" remote get-url origin 2>/dev/null) | $(git -C \"${CLAUDE_PROJECT_DIR:-.}\" branch --show-current)\" >> ~/.claude/push.log; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude finished\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest"
  }
}
